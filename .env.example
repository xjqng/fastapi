# .env.example
# 服务配置
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# MySQL数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB_NAME=secondhand_market

# Redis配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 密钥，生产环境务必换成随机长字符串
SECRET_KEY=replace_this_with_your_secure_random_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
